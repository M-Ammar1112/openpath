# OpenPath environment configuration — copy to .env and adjust.
# NEVER commit .env (it is gitignored).

# --- Backend ---
OPENPATH_ENV=development
OPENPATH_HOST=127.0.0.1
OPENPATH_PORT=8000
OPENPATH_LOG_LEVEL=INFO
# SQLite by default. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/openpath
DATABASE_URL=sqlite:///./data/openpath.db

# --- Frontend ---
VITE_PORT=5173
VITE_API_BASE=/api/v1

# --- Data acquisition ---
# Identify the crawler honestly; do not impersonate browsers.
CRAWLER_USER_AGENT=OpenPathBot/1.0 (+https://github.com/M-Ammar1112/openpath; contact: openpath-local)
CRAWLER_TIMEOUT_SECONDS=20
# Minimum delay between requests to the same host (seconds)
CRAWLER_RATE_LIMIT_SECONDS=2.0
# Honor robots.txt for every source (strongly recommended)
CRAWLER_RESPECT_ROBOTS=true
# Response cache TTL in hours
CRAWLER_CACHE_TTL_HOURS=12

# --- Scheduler (seconds between job runs) ---
REFRESH_INTERVAL_SECONDS=3600
FRESHNESS_SWEEP_INTERVAL_SECONDS=1800
WATCHLIST_CHECK_INTERVAL_SECONDS=1800
# Enable/disable the in-process scheduler entirely
SCHEDULER_ENABLED=true

# --- Ports / origins ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Optional API keys (leave empty when unused) ---
# CROSSREF_API_KEY=
# SERP_API_KEY=